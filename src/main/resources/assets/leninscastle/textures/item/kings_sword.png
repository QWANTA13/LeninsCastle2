package ru.leninscastle.world;

import net.minecraft.core.BlockPos;
import net.minecraft.core.Direction;
import net.minecraft.world.level.block.LadderBlock;
import net.minecraft.world.level.block.entity.ChestBlockEntity;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.Items;
import net.minecraft.server.level.ServerLevel;
import net.minecraft.world.entity.EntityType;
import net.minecraft.world.level.block.Blocks;
import net.minecraft.world.level.block.state.BlockState;
import ru.leninscastle.registry.ModEntities;

/**
 * Прототип процедурной постройки замка.
 * Замок строится командой рядом с игроком; автоматическая генерация в чанках
 * будет отдельным этапом через worldgen structure datapack.
 */
public final class CastleBuilder {
    private CastleBuilder() {}

    private static final BlockState WALL = Blocks.STONE_BRICKS.defaultBlockState();
    private static final BlockState CRACKED = Blocks.CRACKED_STONE_BRICKS.defaultBlockState();
    private static final BlockState FLOOR = Blocks.POLISHED_ANDESITE.defaultBlockState();
    private static final BlockState ROOF = Blocks.DEEPSLATE_BRICKS.defaultBlockState();
    private static final BlockState GLASS = Blocks.GLASS_PANE.defaultBlockState();

    public static void build(ServerLevel level, BlockPos origin, boolean spawnBoss) {
        // Размер площадки 35x35, origin — юго-западный угол.
        int size = 35;
        int baseY = origin.getY();

        // Расчистка внутреннего пространства и основание.
        for (int x = -2; x <= size + 2; x++) {
            for (int z = -2; z <= size + 2; z++) {
                for (int y = 0; y < 20; y++) {
                    level.setBlock(origin.offset(x, y, z), Blocks.AIR.defaultBlockState(), 3);
                }
                level.setBlock(origin.offset(x, -1, z), FLOOR, 3);
            }
        }

        // Внутренний двор.
        fill(level, origin, 3, 0, 3, 31, 0, 31, FLOOR);

        // Наружные стены с воротным проёмом по южной стороне.
        for (int y = 1; y <= 8; y++) {
            for (int i = 3; i <= 31; i++) {
                set(level, origin, i, y, 3, WALL);
                set(level, origin, i, y, 31, WALL);
                set(level, origin, 3, y, i, WALL);
                set(level, origin, 31, y, i, WALL);
            }
            // Оставляем центральный проём ворот шириной 5 блоков.
            if (y <= 5) {
                for (int x = 15; x <= 19; x++) {
                    set(level, origin, x, y, 3, Blocks.AIR.defaultBlockState());
                }
            }
        }

        // Зубцы по периметру.
        for (int i = 3; i <= 31; i += 2) {
            set(level, origin, i, 9, 3, ROOF);
            set(level, origin, i, 9, 31, ROOF);
            set(level, origin, 3, 9, i, ROOF);
            set(level, origin, 31, 9, i, ROOF);
        }

        // Четыре угловые башни.
        tower(level, origin, 3, 3);
        tower(level, origin, 27, 3);
        tower(level, origin, 3, 27);
        tower(level, origin, 27, 27);

        // Главный донжон в северной части двора.
        keep(level, origin, 11, 17, 11, 24, 25, 24);

        // Окна донжона.
        for (int y : new int[]{5, 10, 15, 20}) {
            set(level, origin, 17, y, 11, GLASS);
            set(level, origin, 24, y, 17, GLASS);
        }

        // Тронный зал: пол и трон.
        fill(level, origin, 14, 1, 17, 21, 1, 22, Blocks.RED_CARPET.defaultBlockState());
        set(level, origin, 17, 2, 21, Blocks.GOLD_BLOCK.defaultBlockState());
        set(level, origin, 17, 3, 21, Blocks.GOLD_BLOCK.defaultBlockState());
        set(level, origin, 16, 2, 21, Blocks.GOLD_BLOCK.defaultBlockState());
        set(level, origin, 18, 2, 21, Blocks.GOLD_BLOCK.defaultBlockState());
        set(level, origin, 17, 4, 21, Blocks.GOLD_BLOCK.defaultBlockState());

        // Подъёмный мост, ворота и декоративные цепи.
        for (int z = -5; z <= 2; z++) {
            for (int x = 15; x <= 19; x++) {
                set(level, origin, x, 0, z, Blocks.SPRUCE_PLANKS.defaultBlockState());
            }
        }
        for (int x : new int[]{14, 20}) {
            for (int z = -3; z <= 2; z++)
                set(level, origin, x, 1, z, Blocks.CHAIN.defaultBlockState());
        }
        for (int y = 1; y <= 5; y++)
            for (int x = 15; x <= 19; x++)
                set(level, origin, x, y, 3, Blocks.IRON_BARS.defaultBlockState());

        // Подземелье под двором: камера, лестница и две замаскированные ловушки.
        buildDungeon(level, origin);

        // Факелы во дворе и у входа.
        for (int x : new int[]{8, 26}) {
            set(level, origin, x, 2, 17, Blocks.TORCH.defaultBlockState());
        }
        set(level, origin, 17, 2, 5, Blocks.TORCH.defaultBlockState());

        // Разбитые кирпичи добавляют старинный вид.
        set(level, origin, 7, 4, 3, CRACKED);
        set(level, origin, 28, 6, 31, CRACKED);
        set(level, origin, 3, 3, 24, CRACKED);

        if (spawnBoss) {
            var boss = ModEntities.LENIN_BOSS.get().create(level);
            if (boss != null) {
                boss.moveTo(origin.getX() + 17.5, baseY + 2, origin.getZ() + 19.5,
                        180.0F, 0.0F);
                level.addFreshEntity(boss);
            }
        }
    }

    private static void buildDungeon(ServerLevel level, BlockPos o) {
        // Камера 15x9, высота 4 блока, на 3-7 блоков ниже поверхности.
        int x1 = 10, x2 = 24, z1 = 6, z2 = 14;
        fill(level, o, x1, -7, z1, x2, -7, z2, FLOOR);
        for (int x = x1; x <= x2; x++) for (int z = z1; z <= z2; z++) {
            set(level, o, x, -3, z, WALL);
            if (x == x1 || x == x2 || z == z1 || z == z2)
                for (int y = -6; y <= -4; y++) set(level, o, x, y, z, CRACKED);
            else for (int y = -6; y <= -4; y++) set(level, o, x, y, z, Blocks.AIR.defaultBlockState());
        }
        // Лестничный лаз из двора.
        set(level, o, 8, -1, 8, Blocks.AIR.defaultBlockState());
        for (int y = -6; y <= -1; y++)
            set(level, o, 8, y, 8, Blocks.LADDER.defaultBlockState().setValue(LadderBlock.FACING, Direction.SOUTH));
        set(level, o, 8, 0, 8, Blocks.OAK_TRAPDOOR.defaultBlockState());
        // Короткий проход соединяет лестничный лаз с камерой.
        for (int x = 9; x <= 10; x++)
            set(level, o, x, -5, 8, Blocks.AIR.defaultBlockState());
        // Ловушки: нажимные плиты активируют TNT под полом.
        for (int[] pos : new int[][]{{14, 10}, {20, 10}}) {
            set(level, o, pos[0], -8, pos[1], Blocks.TNT.defaultBlockState());
            set(level, o, pos[0], -7, pos[1], Blocks.STONE_PRESSURE_PLATE.defaultBlockState());
        }
        // Два сундука с заранее заданной добычей.
        placeLootChest(level, o, 11, -6, 7, new ItemStack[]{
                new ItemStack(Items.GOLD_INGOT, 8), new ItemStack(Items.IRON_INGOT, 16),
                new ItemStack(Items.DIAMOND, 2), new ItemStack(Items.GOLDEN_APPLE, 1)});
        placeLootChest(level, o, 23, -6, 13, new ItemStack[]{
                new ItemStack(Items.EMERALD, 12), new ItemStack(Items.ARROW, 32),
                new ItemStack(Items.ENCHANTED_GOLDEN_APPLE, 1)});
    }

    private static void placeLootChest(ServerLevel level, BlockPos o, int x, int y, int z, ItemStack[] loot) {
        BlockPos pos = o.offset(x, y, z);
        level.setBlock(pos, Blocks.CHEST.defaultBlockState(), 3);
        if (level.getBlockEntity(pos) instanceof ChestBlockEntity chest) {
            for (int i = 0; i < loot.length; i++) chest.setItem(i, loot[i]);
            chest.setChanged();
        }
    }

    private static void tower(ServerLevel level, BlockPos o, int x, int z) {
        keep(level, o, x, 0, z, x + 4, 14, z + 4);
        for (int i = 0; i < 5; i++) {
            set(level, o, x + i, 15, z, ROOF);
            set(level, o, x + i, 15, z + 4, ROOF);
            set(level, o, x, 15, z + i, ROOF);
            set(level, o, x + 4, 15, z + i, ROOF);
        }
        set(level, o, x + 2, 14, z + 2, Blocks.LANTERN.defaultBlockState());
        set(level, o, x + 2, 5, z, GLASS);
    }

    private static void keep(ServerLevel level, BlockPos o,
                             int x1, int y1, int z1, int x2, int y2, int z2) {
        for (int x = x1; x <= x2; x++) {
            for (int y = y1; y <= y2; y++) {
                for (int z = z1; z <= z2; z++) {
                    boolean edge = x == x1 || x == x2 || z == z1 || z == z2
                            || y == y1 || y == y2;
                    if (edge) set(level, o, x, y, z, WALL);
                    else set(level, o, x, y, z, Blocks.AIR.defaultBlockState());
                }
            }
        }
        // Крыша.
        fill(level, o, x1 - 1, y2 + 1, z1 - 1, x2 + 1, y2 + 1, z2 + 1, ROOF);
    }

    private static void fill(ServerLevel level, BlockPos o,
                             int x1, int y1, int z1, int x2, int y2, int z2,
                             BlockState state) {
        for (int x = x1; x <= x2; x++)
            for (int y = y1; y <= y2; y++)
                for (int z = z1; z <= z2; z++)
                    set(level, o, x, y, z, state);
    }

    private static void set(ServerLevel level, BlockPos o, int x, int y, int z,
                            BlockState state) {
        level.setBlock(o.offset(x, y, z), state, 3);
    }
}
